{
  "name": "gaming-daily",
  "productName": "Gaming Daily",
  "version": "1.1.0",
  "description": "Daily 100% video-game magazine — news, consoles, PC, modding & retro, esports.",
  "author": "wk0t",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "copy-web": "node copy-web.js",
    "start": "npm run copy-web && electron .",
    "dist": "npm run copy-web && electron-builder --linux AppImage"
  },
  "build": {
    "appId": "com.wk0t.gamingdaily",
    "productName": "Gaming Daily",
    "artifactName": "GamingDaily-${arch}.AppImage",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "News",
      "icon": "build/icon.png",
      "synopsis": "Your daily gaming news",
      "desktop": {
        "Name": "Gaming Daily",
        "Comment": "Daily video-game magazine"
      }
    }
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  }
}
